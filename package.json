{
  "name": "agent-dispatch-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that dispatches bounded tasks from one coding-agent harness to workers in another.",
  "bin": {
    "agent-dispatch": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "node src/main.ts serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:live": "AGENT_DISPATCH_LIVE=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
